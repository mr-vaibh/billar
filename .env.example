# ── Postgres credentials ──────────────────────────────────────────────────────
# These are used by docker-compose for the postgres and backup containers.
POSTGRES_USER=billar
POSTGRES_PASSWORD=billar_secret
POSTGRES_DB=billar

# Port postgres is exposed on the host (container always uses 5432 internally)
POSTGRES_PORT=5433

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Billar

# For local dev (npm run dev) — must match POSTGRES_PORT above
DATABASE_URL=postgresql://billar:billar_secret@localhost:5433/billar

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_min_32_chars

# ── Email (optional) ──────────────────────────────────────────────────────────
# Get a free key at https://resend.com
RESEND_API_KEY=re_your_key_here
RESEND_FROM=Billar <noreply@yourdomain.com>

# ── First-run seed ────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@billar.app
SEED_ADMIN_PASSWORD=change_me_on_first_login
