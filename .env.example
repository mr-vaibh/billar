# Database
DATABASE_URL=postgresql://billar:billar_secret@localhost:5432/billar

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Billar

# Session — must be at least 32 random characters
SESSION_SECRET=change_me_in_production_min_32_chars

# Email — get your key at https://resend.com
RESEND_API_KEY=re_your_key_here
RESEND_FROM=Billar <noreply@yourdomain.com>

# Seed (used by prisma/seed.ts only)
SEED_ADMIN_EMAIL=admin@billar.app
SEED_ADMIN_PASSWORD=change_me_on_first_login
